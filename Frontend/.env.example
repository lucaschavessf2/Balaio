# Copie para .env.local e ajuste apenas se precisar mudar o padrão.
# Nenhuma variável é obrigatória no ambiente local: sem .env.local, a Fake API
# sobe em http://127.0.0.1:3001/api/v1 e o Next.js aponta para ela.

# URL base da Fake API usada pelo servidor do Next.js (SSR) e pelo rewrite de /api/v1.
# No navegador, /api/v1 continua encaminhando para a Fake API.
# Preserve esta origem durante a migração gradual.
API_URL=http://127.0.0.1:3001/api/v1

# Origem privada do API Gateway, lida em tempo de execução pelo servidor Next.js.
# Vazia: as leituras públicas de catálogo no servidor usam explicitamente a Fake API.
# Configurada: Home, busca/filtros/paginação, nomes de peças no Cabeçalho e peças por
# tipo usam GET /pecas no Gateway. Falhas não acionam fallback para a Fake API.
# Os demais endpoints e as chamadas do navegador permanecem na Fake API.
# Não use NEXT_PUBLIC nem substitua API_URL.
# Next.js direto no WSL: http://127.0.0.1:8080/api/v1
# Next.js no Compose: http://api-gateway:8080/api/v1
GATEWAY_API_URL=

# Porta da Fake API (json-server). Se mudar, atualize a porta em API_URL também.
FAKE_API_PORT=3001
