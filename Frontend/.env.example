# Copie para .env.local e ajuste apenas se precisar mudar o padrão.
# Nenhuma variável é obrigatória no ambiente local: sem .env.local, a Fake API
# sobe em http://127.0.0.1:3001/api/v1 e o Next.js aponta para ela.

# URL base da API usada pelo servidor do Next.js (SSR) e pelo rewrite de /api/v1.
# No navegador, o frontend sempre chama /api/v1, que o Next.js encaminha para cá.
# Avaliação 1: Fake API local. Avaliação 2: URL do backend real.
API_URL=http://127.0.0.1:3001/api/v1

# Porta da Fake API (json-server). Se mudar, atualize a porta em API_URL também.
FAKE_API_PORT=3001
