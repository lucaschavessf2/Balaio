# Copie para .env.local. Autenticação exige gateway + profile configurados.

# Somente capacidades simuladas. Nunca aponte o gateway para este destino.
API_URL=http://127.0.0.1:3001/api/v1

# Porta da Fake API (json-server). Se mudar, atualize a porta em API_URL também.
FAKE_API_PORT=3001
API_GATEWAY_URL=http://127.0.0.1:8080/api/v1

# Mutações da conta na Fake API exigem estas origens exatas.
AUTH_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# npm run dev / launcher de produção geram a chave interna em memória.
# Se iniciar Next e Fake separadamente, configure BALAIO_FAKE_INTERNAL_KEY
# com o mesmo segredo aleatório (pelo menos 32 caracteres) nos dois processos.
